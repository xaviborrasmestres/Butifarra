/* nivell mitjà */
function midPick(seat,hand,L){
  const low=a=>a.slice().sort((x,y)=>pts(x)-pts(y)||str(x)-str(y))[0];
  if(!G.trick.length){
    const masters=L.filter(c=>isMaster(c,hand));
    const nt=masters.filter(c=>c.s!==G.trump);
    if(nt.length)return nt.sort((a,b)=>pts(b)-pts(a))[0];
    if(masters.length)return masters.sort((a,b)=>pts(b)-pts(a))[0];
    const nonT=L.filter(c=>c.s!==G.trump);return low(nonT.length?nonT:L);
  }
  const w=winnerOf(G.trick,G.trump), partnerWin=team(w.seat)===team(seat);
  if(partnerWin)return L.slice().sort((a,b)=>pts(b)-pts(a)||str(a)-str(b))[0];
