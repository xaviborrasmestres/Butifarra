/* ---------- regles ---------- */
function beats(a,b,trump){            // la carta a guanya a la carta b (que va guanyant la basa)?
  const ta=a.s===trump, tb=b.s===trump;
  if(ta&&!tb)return true;
  if(!ta&&tb)return false;
  if(a.s===b.s)return str(a)>str(b);
  return false;
}
function winnerOf(trick,trump){
  let best=trick[0];
  for(let i=1;i<trick.length;i++) if(beats(trick[i].card,best.card,trump)) best=trick[i];
  return best;
}
function legal(hand,trick,trump,seat){
  if(!trick.length)return hand.slice();
  const lead=trick[0].card.s, w=winnerOf(trick,trump), partnerWin=team(w.seat)===team(seat);
  const same=hand.filter(c=>c.s===lead);
  if(same.length){
    if(partnerWin)return same;
    const over=same.filter(c=>beats(c,w.card,trump));
    return over.length?over:same;
  }
  if(partnerWin)return hand.slice();
  const tr=hand.filter(c=>c.s===trump);
  if(tr.length){const over=tr.filter(c=>beats(c,w.card,trump));return over.length?over:tr}
  return hand.slice();
}
function explain(){
  const hand=G.hands[0],t=G.trick;
  if(!t.length)return 'Surts tu: pots jugar qualsevol carta.';
  const lead=t[0].card.s,w=winnerOf(t,G.trump),pw=team(w.seat)===0;
  const same=hand.filter(c=>c.s===lead);
  if(same.length){
    if(pw)return `Has de servir ${SUITN[lead]}. La teva company guanya: no cal superar.`;
    const over=same.filter(c=>beats(c,w.card,G.trump));
    return over.length?`Has de servir ${SUITN[lead]} i superar la carta que guanya (${NAMES[w.seat]}).`:`Has de servir ${SUITN[lead]}; no pots superar-la, juga'n la que vulguis.`;
  }
  if(pw)return `No tens ${SUITN[lead]} i guanya la teva company: pots jugar qualsevol carta.`;
  const tr=hand.filter(c=>c.s===G.trump);
  if(tr.length){
    const over=tr.filter(c=>beats(c,w.card,G.trump));
    return over.length?'No tens el pal: has de fallar amb triomf i sobrefallar.':'No tens el pal: has de fallar amb triomf (no pots sobrefallar).';
  }
  return `No tens ${SUITN[lead]} ni triomf: pots jugar qualsevol carta.`;
}

