function mcPick(seat,hand,L,budget){
  if(L.length===1)return L[0];
  const real=G,U=unseenFor(seat);
  const sizes=[0,1,2,3].map(s=>s===seat?0:real.hands[s].length);
  const K=Math.max(8,Math.min(48,Math.floor((budget||360)/L.length)));
  const sc=L.map(()=>0),me=team(seat),t0=performance.now();
  for(let k=0;k<K;k++){
    if(k>=4&&performance.now()-t0>380)break;
    const hs=determinize(seat,U,sizes);
    for(let i=0;i<L.length;i++){
      const st={hands:hs.map(h=>h.slice()),trick:real.trick.slice(),played:new Set(real.played),void:real.void.map(v=>Object.assign({},v)),trump:real.trump,chooser:real.chooser};
      st.hands[seat]=hand.slice();
      G=st;doPlay(seat,L[i]);G=real;
      const r=playoutFrom(st,(seat+1)%4);
      sc[i]+=r[me]-r[1-me];
    }
  }
  let bi=0;for(let i=1;i<L.length;i++)if(sc[i]>sc[bi])bi=i;
  return L[bi];
}
function mcChoose(seat,canPass,thr){
  const real=G,h=real.hands[seat],opts=SUITS.concat(['B']);
  const U=ALL.filter(c=>!h.some(x=>x.s===c.s&&x.r===c.r));
  let KK=0;const K=40,me=team(seat),sc={};opts.forEach(o=>sc[o]=0);
  const first=((real.dealer==null?0:real.dealer)+1)%4;
  const t1=performance.now();
  for(let k=0;k<K;k++){
    if(k>=8&&performance.now()-t1>450)break;
    const pool=shuffle(U.slice()),hs=[[],[],[],[]];
    for(let s=0;s<4;s++)hs[s]=s===seat?h.slice():pool.splice(0,12);
    for(const o of opts){
      const st={hands:hs.map(x=>x.slice()),trick:[],played:new Set(),void:[{},{},{},{}],trump:o,chooser:seat};
      const r=playoutFrom(st,first);
      sc[o]+=(r[me]-36)*(o==='B'?2:1);
    }
    KK++;
  }
  let best=opts[0];for(const o of opts)if(sc[o]>sc[best])best=o;
  const avg=sc[best]/Math.max(1,KK);
  if(canPass&&avg<(thr==null?0:thr))return 'pass';
  return best;
}

function botMove(seat){
  const hand=G.hands[seat], L=legal(hand,G.trick,G.trump,seat);
  let pick;
  if(CFG.level==='expert'){try{pick=mcPick(seat,hand,L)}catch(e){pick=midPick(seat,hand,L)}}
  else if(CFG.level==='facil'&&Math.random()<.45)pick=L[Math.floor(Math.random()*L.length)];
  else pick=midPick(seat,hand,L);
  play(seat,pick);
}
function humanPlay(c){
  if(G.phase!=='play'||G.turn!==0||G.busy)return;
  if(!legal(G.hands[0],G.trick,G.trump,0).includes(c))return;
  play(0,c);
}
function play(seat,card){
  if(seat===0){G.sel=null;hidePreview()}
  if(G.trick.length){const lead=G.trick[0].card.s;if(card.s!==lead)G.void[seat][lead]=true}
  const h=G.hands[seat];h.splice(h.indexOf(card),1);
  G.trick.push({seat,card});G.played.add(card.s+card.r);
  sfx('play');
  if(G.trick.length===4){G.busy=true;render();later(resolveTrick,1300)}
  else{G.turn=(seat+1)%4;render();next()}
}
function floatPts(n,t){
  const from=ctr($('center')), to=ctr($(t===0?'scus':'scthem'));
  const el=document.createElement('div');el.className='fp';el.textContent='+'+n;
  el.style.left=from[0]+'px';el.style.top=from[1]+'px';document.body.appendChild(el);
  const an=el.animate([
    {transform:'translate(-50%,-50%) scale(.6)',opacity:0},
    {transform:'translate(-50%,-70%) scale(1.5)',opacity:1,offset:.25},
    {transform:'translate(-50%,-70%) scale(1.5)',opacity:1,offset:.5},
    {transform:`translate(calc(-50% + ${to[0]-from[0]}px),calc(-50% + ${to[1]-from[1]}px)) scale(.7)`,opacity:.9}
  ],{duration:650,easing:'ease-in-out'});
  an.onfinish=()=>{el.remove();const b=$(t===0?'scus':'scthem');b.classList.remove('pulse');b.offsetHeight;b.classList.add('pulse');sfx('pts')};
}
function resolveTrick(){
  const w=winnerOf(G.trick,G.trump), t=team(w.seat);
  const tp=G.trick.reduce((a,x)=>a+pts(x.card),0)+1;
  const copy=G.trick.map(x=>({seat:x.seat,card:x.card}));
  const [tx,ty]=ctr(seatEl(w.seat));
  document.querySelectorAll('.slot .card').forEach(el=>{
    const [cx,cy]=ctr(el);
    el.animate([{transform:'none',opacity:1},{transform:`translate(${tx-cx}px,${ty-cy}px) scale(.3) rotate(30deg)`,opacity:0}],{duration:430,easing:'ease-in',fill:'forwards'});
  });
  sfx(t===0?'win':'lose');
  if(w.card.r===9)sfx('manilla');
  floatPts(tp,t);
  later(()=>{
    G.tricks[t]++;G.cardPts[t]+=tp-1;
    G.last={cards:copy,winner:w.seat};G.history.push(G.last);
    G.trick=[];G.busy=false;
    if(G.hands[0].length===0){endHand();return}
    G.turn=w.seat;
    say(`${NAMES[w.seat]} guanya la basa i surt.`);
    render();next();
  },720);
}

/* ---------- final de mà, resum i estadístiques ---------- */
function recordHand(usWon){
  STATS.hands++;
  if(usWon){STATS.handsWon++;STATS.streak++;if(STATS.streak>STATS.best)STATS.best=STATS.streak}
  else STATS.streak=0;
  saveJ('but.stats',STATS);
}
function recordGame(win){
  STATS.games++;if(win)STATS.wins++;
  const l=STATS.byLevel[CFG.level]||(STATS.byLevel[CFG.level]={games:0,wins:0});
  l.games++;if(win)l.wins++;
  saveJ('but.stats',STATS);
}
function trickRow(t,i,big){
  return `<div class="trow${big?' big':''}"><span class="tn">${i==null?'':i+1}</span>${t.cards.map(x=>`<div class="tc${x.seat===t.winner?' w':''}"><div class="mc">${cardSVG(x.card)}</div><small>${NAMES[x.seat]}</small></div>`).join('')}</div>`;
}
function endHand(){
  G.phase='end';
  const p=[G.cardPts[0]+G.tricks[0],G.cardPts[1]+G.tricks[1]];
  const diff=Math.abs(p[0]-36), gain=diff*G.mult;
  let res,usWon=p[0]>36;
  if(p[0]>36){S.us+=gain;STATS.pts+=gain;res=`Heu guanyat la mà: <b>+${gain}</b>`}
  else if(p[0]<36){S.them+=gain;res=`Han guanyat la mà: <b>+${gain}</b> per a ells`}
  else res='Empat a 36: ningú puntua.';
  recordHand(usWon);
  render();
  const over=S.us>=101||S.them>=101;
  const winGame=over&&S.us>=S.them;
  if(over)recordGame(winGame);
  sfx(over?(winGame?'handwin':'handlose'):(usWon?'handwin':'handlose'));
  const title=over?(winGame?'🏆 Heu guanyat la partida!':'Han guanyat la partida'):'Final de la mà';
  const ml=G.multLog.length?G.multLog.join(' · '):'Cap doblatge';
  const html=`<h2>${title}</h2>
   <table class="sum"><tr><th></th><th>Nosaltres</th><th>Ells</th></tr>
   <tr><td>Punts de cartes</td><td>${G.cardPts[0]}</td><td>${G.cardPts[1]}</td></tr>
   <tr><td>Basses (1 punt cada una)</td><td>${G.tricks[0]}</td><td>${G.tricks[1]}</td></tr>
   <tr class="tot"><td>Total</td><td>${p[0]}</td><td>${p[1]}</td></tr></table>
   <p><small>Es puntua la diferència respecte a 36. Multiplicador: <b>x${G.mult}</b> (${ml}).</small></p>
   <p>${res}</p>
   <p>Marcador: nosaltres <b>${S.us}</b> – ells <b>${S.them}</b></p>
   <div class="row"><button class="btn sec2" id="hist">Veure les basses</button><button class="btn" id="go">${over?'Nova partida':'Següent mà'}</button></div>`;
  G.sumHTML=html;
  openOv(html);
  bindSummary(over);
}
function bindSummary(over){
  $('go').onclick=()=>{if(over){S={us:0,them:0}}startHand()};
  $('hist').onclick=()=>{
    openOv(`<h2>Basses de la mà</h2><p><small>El requadre verd marca qui s'ha endut la basa.</small></p>${G.history.map((t,i)=>trickRow(t,i)).join('')}<div class="row"><button class="btn" id="bk">Enrere</button></div>`);
    $('bk').onclick=()=>{openOv(G.sumHTML);bindSummary(over)};
  };
}
function openLast(){
  if(!G||!G.last)return;
  const t=G.last;
  openOv(`<h2>Última basa</h2>${trickRow(t,null,true)}<p>Se l'ha endut <b>${NAMES[t.winner]}</b>.</p><div class="row"><button class="btn sec2" id="all">Totes les basses</button><button class="btn" id="cl">Tanca</button></div>`);
  $('cl').onclick=()=>{$('ov').style.display='none'};
  $('all').onclick=()=>{
    openOv(`<h2>Basses de la mà</h2>${G.history.map((x,i)=>trickRow(x,i)).join('')}<div class="row"><button class="btn" id="cl">Tanca</button></div>`);
    $('cl').onclick=()=>{$('ov').style.display='none'};
  };
}

/* ---------- interfície ---------- */
function say(t){$('msg').textContent=t}
function setActions(title,btns){
  const a=$('actions');a.innerHTML='';
  if(title){const d=document.createElement('div');d.className='ttl';d.textContent=title;a.appendChild(d)}
  btns.forEach(b=>{const e=document.createElement('button');e.className='btn'+(b.sec?' sec':'');e.innerHTML=b.label;e.onclick=b.fn;a.appendChild(e)});
}
function cardEl(c,o={}){
  const d=document.createElement('div');
  d.className='card'+(c.s===G.trump?' t':'')+(o.legal?' legal':'')+(o.dim?' dim':'')+(o.win?' win':'');
  d.innerHTML=cardSVG(c);
  return d;
}
function render(){
  $('sc-us').textContent=S.us;$('sc-them').textContent=S.them;
  const showHP=G.phase==='play'||G.phase==='end';
  $('hp-us').textContent=showHP?`mà: ${G.cardPts[0]+G.tricks[0]}`:'';
  $('hp-them').textContent=showHP?`mà: ${G.cardPts[1]+G.tricks[1]}`:'';
  $('lastbtn').style.display=G.last?'block':'none';
  const tr=$('trump');
  tr.innerHTML=G.trump?((G.trump==='B'?'Butifarra':ICON[G.trump]+SUITN[G.trump])+(G.mult>1?`<span class="badge">x${G.mult}</span>`:'')):'—';
  for(let i=1;i<=3;i++){$('n'+i).textContent=G.hands[i].length;$('seat'+i).classList.toggle('turn',G.phase==='play'&&G.turn===i&&!G.busy)}
  let win=null;if(G.trick.length===4)win=winnerOf(G.trick,G.trump).seat;
  for(let i=0;i<4;i++){
    const s=$('c'+i);s.innerHTML='';
    const x=G.trick.find(t=>t.seat===i);
    if(x){const e=cardEl(x.card,{win:win===i});s.appendChild(e);
      const key=x.card.s+x.card.r;
      if(!G.shown.has(key)){G.shown.add(key);flyIn(e,i)}}
  }
  const L=(G.phase==='play'&&G.turn===0&&!G.busy)?legal(G.hands[0],G.trick,G.trump,0):[];
  const sug=(CFG.help&&L.length>1)?G.sug:null;
  const hd=$('hand');hd.innerHTML='';
  const k0=((0-(G.dealer+1))%4+4)%4, anim=G.dealing&&!G.handAnimated;
  G.hands[0].forEach((c,j)=>{
    const ok=L.includes(c);
    const e=cardEl(c,{legal:ok,dim:L.length>0&&!ok});
    if(c===sug)e.classList.add('star');
    e.__c=c;
    e.onclick=()=>{
      if(G.sel!==c){G.sel=c;markSel();showPreview(c,e);sfx('sel');
        say(ok?'Torna a tocar la carta per jugar-la.':(G.phase==='play'&&G.turn===0?(CFG.help?explain():'Aquesta carta no es pot jugar ara.'):'Aquesta és la teva carta.'));return}
      G.sel=null;hidePreview();markSel();
      if(ok){G.fromRect=e.getBoundingClientRect();humanPlay(c)}
    };
    if(anim){e.classList.add('dealin');e.style.animationDelay=((j*4+k0)*38+350)+'ms'}
    hd.appendChild(e);
  });
  if(anim)G.handAnimated=true;
  const selEl=[...hd.children].find(x=>x.__c===G.sel);
  if(G.sel&&selEl){markSel();showPreview(G.sel,selEl)}else{G.sel=null;hidePreview()}
}
function markSel(){[...$('hand').children].forEach(x=>x.classList.toggle('sel',x.__c===G.sel))}
$('pv').onclick=()=>{const c=G.sel;if(!c)return;const el=[...$('hand').children].find(x=>x.__c===c);if(el)el.click()};
function hidePreview(){$('pv').style.display='none'}
function showPreview(c,el,ok){
  const pv=$('pv'),r=el.getBoundingClientRect(),w=Math.min(170,innerWidth*.42),h=w*1.4;
  const can=G.phase==='play'&&G.turn===0&&!G.busy&&legal(G.hands[0],G.trick,G.trump,0).includes(c);
  pv.innerHTML=cardSVG(c)+`<div class="hint${can?'':' no'}">${can?'Toca per jugar':'No es pot jugar ara'}</div>`;pv.style.width=w+'px';
  pv.style.left=Math.max(8,Math.min(innerWidth-w-8,r.left+r.width/2-w/2))+'px';
  pv.style.top=Math.max(8,r.top-h-12)+'px';
  pv.style.display='block';
  pv.style.animation='none';pv.offsetHeight;pv.style.animation='';
}
function openOv(h){$('ovbox').innerHTML=h;$('ov').style.display='flex'}
function closeOv(){$('ov').style.display='none'}

/* ---------- menú, estadístiques i regles ---------- */
function seg(k,opts){return `<div class="seg">${opts.map(([v,l])=>`<button data-k="${k}" data-v="${v}" class="${String(CFG[k])===String(v)?'on':''}">${l}</button>`).join('')}</div>`}
function openMenu(){
  openOv(`<h2>Opcions</h2>
  <div class="opt"><span>Dificultat</span>${seg('level',[['facil','Fàcil'],['mitja','Mitjà'],['expert','Expert']])}</div>
  <div class="opt"><span>Ajuda (★ i regles)</span>${seg('help',[[false,'No'],[true,'Sí']])}</div>
  <div class="opt"><span>So</span>${seg('sound',[[true,'Sí'],[false,'No']])}</div>
  <div class="opt"><span>Tapet</span>${seg('felt',[['verd','Verd'],['blau','Blau'],['granat','Granat'],['clar','Clar']])}</div>
  <div class="opt"><span>Revers</span>${seg('back',[['senyera','Senyera'],['rajola','Rajola'],['sobri','Sobri']])}</div>
  <div class="opt"><span>Cartes</span>${seg('big',[[false,'Normals'],[true,'Grans']])}</div>
  <div class="row"><button class="btn sec2" id="mst">Estadístiques</button><button class="btn sec2" id="mru">Regles</button><button class="btn sec2" id="mnm">Nova partida</button></div>
  <div class="row"><button class="btn" id="cl">Tanca</button></div>`);
  $('ovbox').querySelectorAll('.seg button').forEach(b=>b.onclick=()=>{
    const k=b.dataset.k,v=b.dataset.v;
    CFG[k]=(k==='help'||k==='sound'||k==='big')?v==='true':v;
    saveJ('but.cfg',CFG);applyCfg();
    b.parentNode.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b));
    if(k==='sound'&&CFG.sound)sfx('sel');
    if(G&&G.hands)render();
  });
  $('cl').onclick=closeOv;
  $('mst').onclick=openStats;$('mru').onclick=openRules;
  $('mnm').onclick=()=>{closeOv();newMatch()};
}
function openStats(){
  const pc=STATS.games?Math.round(STATS.wins/STATS.games*100):0, ph=STATS.hands?Math.round(STATS.handsWon/STATS.hands*100):0;
  const L=['facil','mitja','expert'].map(l=>{const x=STATS.byLevel[l]||{games:0,wins:0};return `<tr><td>${{facil:'Fàcil',mitja:'Mitjà',expert:'Expert'}[l]}</td><td>${x.wins} / ${x.games}</td></tr>`}).join('');
  openOv(`<h2>Estadístiques</h2>
  <table class="sum"><tr><td>Partides guanyades</td><td><b>${STATS.wins}</b> de ${STATS.games} (${pc}%)</td></tr>
  <tr><td>Mans guanyades</td><td><b>${STATS.handsWon}</b> de ${STATS.hands} (${ph}%)</td></tr>
  <tr><td>Ratxa actual / millor</td><td>${STATS.streak} / <b>${STATS.best}</b></td></tr>
  <tr><td>Punts totals aconseguits</td><td>${STATS.pts}</td></tr></table>
  <h3 style="margin:10px 0 2px;font-size:15px">Per dificultat (guanyades / jugades)</h3>
  <table class="sum">${L}</table>
  ${canStore?'':'<p><small>Aquest navegador no deixa desar dades: les estadístiques només duren mentre la pàgina és oberta.</small></p>'}
  <div class="row"><button class="btn sec2" id="bk">Enrere</button><button class="btn sec2" id="rs">Esborra-les</button></div>`);
  $('bk').onclick=openMenu;
  $('rs').onclick=()=>{STATS=Object.assign({},ST0,{byLevel:{}});saveJ('but.stats',STATS);openStats()};
}
function openRules(){
  openOv(`<h2>Regles</h2>
  <ul>
   <li>Toca una carta de la teva mà per veure-la en gran; torna-la a tocar per jugar-la.</li>
   <li>Baralla de 48 cartes, 4 jugadors en parelles (tu + Montse contra Pere + Jordi). Es juga en sentit antihorari.</li>
   <li>Ordre: 9 (manilla), As, Rei, Cavall, Sota, 8, 7, 6, 5, 4, 3, 2.</li>
   <li>Punts: manilla 5, as 4, rei 3, cavall 2, sota 1, i 1 per cada basa (72 en total).</li>
   <li>Qui reparteix tria el triomf o <b>Butifarra</b> (sense triomf, punts x2). Pot passar i llavors tria la seva company.</li>
   <li>Els rivals poden <b>contrar</b> (x2); els altres, <b>recontrar</b> (x2) i els rivals, <b>Sant Vicenç</b> (x2, només amb triomf).</li>
   <li>Cal servir el pal. Si el rival va guanyant, has de superar-lo si pots; si no tens el pal, has de fallar amb triomf (i sobrefallar si pots). Si guanya la teva company, pots jugar el que vulguis.</li>
   <li>Guanya la mà qui passa de 36 punts; es puntua la diferència amb 36 multiplicada pels doblatges. La partida és a 101.</li>
  </ul>
  <div class="row"><button class="btn" id="bk">Enrere</button></div>`);
  $('bk').onclick=openMenu;
}
$('menu').onclick=openMenu;
$('center').insertAdjacentHTML('beforeend','<button id="lastbtn" style="display:none">↺<br>Última</button>');
$('lastbtn').onclick=openLast;
newMatch();
</script>
