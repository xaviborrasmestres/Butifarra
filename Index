function determinize(seat,U,sizes){
  const others=[0,1,2,3].filter(s=>s!==seat);
  for(let attempt=0;attempt<25;attempt++){
    const pool=shuffle(U.slice()),hs=[[],[],[],[]];let ok=true;
    for(const c of pool){
      const el=others.filter(o=>hs[o].length<sizes[o]&&!G.void[o][c.s]);
      if(!el.length){ok=false;break}
      let tot=0;for(const o of el)tot+=sizes[o]-hs[o].length;
      let r=Math.random()*tot,pick=el[0];
      for(const o of el){r-=sizes[o]-hs[o].length;if(r<=0){pick=o;break}}
      hs[pick].push(c);
    }
    if(ok)return hs;
  }
  const pool=shuffle(U.slice()),hs=[[],[],[],[]];
  for(const o of others)hs[o]=pool.splice(0,sizes[o]);
  return hs;
