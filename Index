<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Butifarra</title>
<style>
:root{--felt:#1f5c3a;--felt2:#143d27;--card:#fbf6e6;--ink:#222;--gold:#ffd54a}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:#0b2216;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#fff;display:flex;justify-content:center}
#app{width:100%;max-width:480px;min-height:100vh;display:flex;flex-direction:column;background:radial-gradient(ellipse at 50% 35%,var(--felt),var(--felt2));padding:8px 8px 14px}
body{background:#0b2216 radial-gradient(var(--b1),var(--b2))}
.senyera{height:9px;border-radius:5px;margin-bottom:6px;background:repeating-linear-gradient(90deg,#f6c500 0 11.11%,#c8102e 11.11% 22.22%);background-size:100% 100%;box-shadow:0 1px 3px #0008}
#frame{margin:12px 3px 14px;border:13px solid transparent;border-radius:20px;padding:4px 4px 2px;background:var(--noise) padding-box,radial-gradient(ellipse at 50% 42%,var(--f1) 0,var(--f2) 55%,var(--f3) 100%) padding-box,var(--tile) border-box;box-shadow:0 0 0 3px #d8b23a,0 0 0 4px #5a3d00,0 0 0 8px #4a2d12,0 0 0 9px #2a1608,0 8px 18px #000c,inset 0 0 0 2px #d8b23a55,inset 0 0 26px #000a}
.med{position:absolute;inset:0;width:100%;height:100%;opacity:.5;pointer-events:none}
.av{width:40px;height:40px;filter:drop-shadow(0 2px 2px #0008)}
.seat{display:flex;flex-direction:column;align-items:center}
.seat.top{flex-direction:row}
.seat.top .av{width:38px;height:38px}
.ttl2{font-family:Georgia,serif;font-style:italic;font-size:19px;color:#ffe08a;text-shadow:0 2px 0 #7a1010,0 3px 6px #000}
#frieze{display:flex;justify-content:space-around;align-items:center;padding:3px 6px 1px;border-top:1px dashed #ffffff30;margin-top:2px}
#frieze svg{height:36px;width:auto;filter:drop-shadow(0 1px 1px #0008)}
.flyback{position:fixed;width:34px;height:48px;border-radius:5px;border:1px solid #fff;pointer-events:none;z-index:8;background:repeating-linear-gradient(90deg,#f6c500 0 4px,#c8102e 4px 8px);box-shadow:0 2px 4px #0008;opacity:0}
@keyframes dealin{from{opacity:0;transform:translateY(-80px) scale(.45) rotate(-25deg)}to{opacity:1;transform:none}}
.dealin{animation:dealin .42s cubic-bezier(.2,.9,.3,1.15) backwards}
header{display:flex;align-items:center;gap:8px;justify-content:space-between;font-size:14px}
.sc{background:#0006;border-radius:10px;padding:5px 10px;text-align:center;line-height:1.15}
.sc b{display:block;font-size:20px}
.mid{flex:1;text-align:center;font-size:13px}
.mid .tr{display:flex;align-items:center;justify-content:center;gap:4px;font-weight:700;font-size:15px}
.mid svg{width:20px;height:20px}
.badge{background:var(--gold);color:#000;border-radius:8px;padding:0 6px;font-size:12px;font-weight:800;margin-left:4px}
.ibtn{background:#0006;border:0;color:#fff;border-radius:10px;padding:8px 10px;font-size:13px}
#table{display:grid;grid-template-columns:62px 1fr 62px;grid-template-rows:auto 252px;gap:4px;margin-top:2px}
.seat{text-align:center;font-size:12px;opacity:.9}
.seat .mini{box-shadow:0 0 0 2px #2a1a0a;width:34px;margin:2px auto 0;aspect-ratio:5/7;border-radius:5px;border:1px solid #fff;background:repeating-linear-gradient(90deg,#f6c500 0 4px,#c8102e 4px 8px);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;text-shadow:0 1px 2px #000}
.seat.turn .nm2{color:var(--gold);font-weight:800}
.seat.top{grid-column:1/4;display:flex;align-items:center;justify-content:center;gap:8px}
.seat.top .mini{margin:0}
.seat.left,.seat.right{align-self:center}
#center{position:relative}
.slot{position:absolute;width:72px}
#c0{bottom:0;left:50%;transform:translateX(-50%)}
#c2{top:0;left:50%;transform:translateX(-50%)}
#c1{right:0;top:80px}
#c3{left:0;top:80px}
.card{position:relative;border-radius:8px;box-shadow:0 1px 3px #0007;aspect-ratio:5/7;user-select:none;width:100%;line-height:0}
.card svg{width:100%;height:100%;display:block}
.card.t{box-shadow:0 0 0 2px #e0a800,0 1px 3px #0007}
.card.legal{outline:3px solid var(--gold);transform:translateY(-6px);cursor:pointer}
.card.dim{opacity:.4}
.card.win{box-shadow:0 0 0 3px #7cff9e,0 0 12px #7cff9e}
#msg{min-height:34px;text-align:center;font-size:14px;margin:6px 0 2px;padding:0 4px}
#actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;min-height:46px;margin-bottom:4px}
#actions .ttl{width:100%;text-align:center;font-size:13px;opacity:.85}
.btn{background:var(--gold);color:#000;border:0;border-radius:12px;padding:10px 14px;font-weight:800;font-size:15px;display:flex;align-items:center;gap:6px}
.btn.sec{background:#ffffff26;color:#fff}
.btn svg{width:20px;height:20px}
#hand{display:grid;grid-template-columns:repeat(6,1fr);gap:5px;padding:10px 2px 2px}
#pv{position:fixed;display:none;z-index:7;pointer-events:auto;cursor:pointer;touch-action:manipulation;filter:drop-shadow(0 8px 14px #000c);animation:pvin .18s ease-out}
#pv svg{width:100%;display:block}
#pv .hint{position:absolute;left:50%;bottom:-14px;transform:translateX(-50%);white-space:nowrap;background:var(--gold);color:#000;font-weight:800;font-size:13px;line-height:1;padding:8px 14px;border-radius:14px;box-shadow:0 3px 8px #000a}
#pv .hint.no{background:#ddd;color:#555}
.card{touch-action:manipulation}
@keyframes pvin{from{opacity:0;transform:translateY(12px) scale(.85)}}
.card.sel{transform:translateY(-12px) scale(1.06);z-index:2;box-shadow:0 0 0 3px #fff,0 6px 12px #000a}
#ov{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;padding:16px;z-index:9}
#ov .box{background:#fbf6e6;color:#222;border-radius:16px;padding:18px;max-width:420px;width:100%;max-height:88vh;overflow:auto;font-size:14px;line-height:1.45}
#ov h2{margin:0 0 8px;font-size:20px}
#ov ul{padding-left:18px;margin:6px 0}
#ov .btn{margin:12px auto 0}

body,body[data-felt=verd]{--f1:#2f8a58;--f2:#1f5c3a;--f3:#10331f;--b1:#12361f;--b2:#0b2216}
body[data-felt=blau]{--f1:#3a6cae;--f2:#234a80;--f3:#112849;--b1:#14284a;--b2:#0a1426}
body[data-felt=granat]{--f1:#a83a52;--f2:#76243a;--f3:#3d1020;--b1:#3a1420;--b2:#1c0a10}
body[data-felt=clar]{--f1:#f1e6cb;--f2:#dccba4;--f3:#bfa878;--b1:#4a3f2c;--b2:#2e2619}
body[data-felt=clar] .seat .nm2{color:#2a1a0a}
body[data-felt=clar] #msg{color:#fff}
body[data-back=rajola] .seat .mini,body[data-back=rajola] .flyback{background:var(--tile) !important;background-size:13px 13px !important}
body[data-back=sobri] .seat .mini,body[data-back=sobri] .flyback{background:repeating-linear-gradient(45deg,#4a0f1c 0 3px,#661a2b 3px 6px) !important}
body.big #hand{grid-template-columns:repeat(4,1fr);gap:7px}
.sc small{display:block;font-size:11px;opacity:.85;min-height:13px}
.sc.pulse{animation:pulse .55s}
@keyframes pulse{40%{transform:scale(1.18);background:#2ea44f}}
.fp{position:fixed;z-index:9;pointer-events:none;font-weight:900;font-size:26px;color:#ffe08a;text-shadow:0 2px 0 #7a1010,0 0 10px #000}
.card.star::after{content:'★';position:absolute;top:-9px;right:-5px;width:20px;height:20px;line-height:20px;text-align:center;font-size:13px;border-radius:50%;background:var(--gold);color:#7a1010;box-shadow:0 1px 4px #000a;z-index:3}
#lastbtn{position:absolute;left:0;bottom:0;z-index:3;width:46px;padding:4px 0;border:0;border-radius:10px;background:#0008;color:#fff;font-size:11px;line-height:1.15}
#ov .btn.sec2{background:#0001;color:#222;border:1px solid #b9a97a}
#ov .row{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:12px}
#ov .row .btn{margin:0}
.sum{width:100%;border-collapse:collapse;margin:6px 0}
.sum td,.sum th{padding:5px 6px;border-bottom:1px solid #d8cba5;text-align:right}
.sum td:first-child,.sum th:first-child{text-align:left}
.sum tr.tot td{font-weight:800;border-top:2px solid #2a1a0a}
.opt{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:9px 0}
.seg{display:flex;border:1px solid #b9a97a;border-radius:10px;overflow:hidden}
.seg button{border:0;background:#fffaf0;padding:8px 10px;font-size:13px;color:#222}
.seg button.on{background:#c8102e;color:#fff;font-weight:700}
.trow{display:flex;gap:6px;align-items:center;margin:7px 0}
.trow .tn{width:16px;font-weight:700}
.tc{width:52px;text-align:center}
.tc .mc{line-height:0;border-radius:7px}
.tc.w .mc{box-shadow:0 0 0 3px #2ea44f}
.tc small{font-size:10px;color:#444;display:block;margin-top:2px}
.trow.big .tc{width:66px}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<linearGradient id="gGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff3a6"/><stop offset=".5" stop-color="#f2c230"/><stop offset="1" stop-color="#a87206"/></linearGradient>
<linearGradient id="gCoinRim" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe58a"/><stop offset=".55" stop-color="#e0a820"/><stop offset="1" stop-color="#8a5a00"/></linearGradient>
