  const h=G.hands[seat];h.splice(h.indexOf(c),1);G.trick.push({seat,card:c});G.played.add(c.s+c.r);
}
function playoutFrom(st,turn){
  const real=G;G=st;const r=[0,0];let t=turn;
  try{
    for(;;){
      while(G.trick.length<4){
        const h=G.hands[t],L=legal(h,G.trick,G.trump,t);
        const c=L.length===1?L[0]:midPick(t,h,L);
