<linearGradient id="gBlue" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6aa0ea"/><stop offset=".5" stop-color="#2d63b8"/><stop offset="1" stop-color="#163a7a"/></linearGradient>
<linearGradient id="gGreen" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#68cc82"/><stop offset=".5" stop-color="#2f8f4e"/><stop offset="1" stop-color="#17542c"/></linearGradient>
<linearGradient id="gGlass" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#e8fff0"/><stop offset=".4" stop-color="#9fdcae"/><stop offset="1" stop-color="#4f9a66"/></linearGradient>
<linearGradient id="gSausage" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e6866e"/><stop offset=".5" stop-color="#b5483a"/><stop offset="1" stop-color="#6e1f18"/></linearGradient>
</defs></svg>
<div id="app">
  <div class="senyera"></div>
  <header>
    <div class="sc" id="scus">Nosaltres<b id="sc-us">0</b><small id="hp-us"></small></div>
    <div class="mid"><div class="ttl2">Butifarra</div><div class="tr" id="trump">—</div></div>
    <div class="sc" id="scthem">Ells<b id="sc-them">0</b><small id="hp-them"></small></div>
    <button class="ibtn" id="menu">☰</button>
  </header>

  <div id="frame"><div id="table">
    <div class="seat top" id="seat2"><span class="nm2">Montse (company)</span><div class="mini" id="n2"></div></div>
    <div class="seat left" id="seat3"><span class="nm2">Jordi</span><div class="mini" id="n3"></div></div>
    <div id="center">
      <div class="slot" id="c0"></div><div class="slot" id="c1"></div>
      <div class="slot" id="c2"></div><div class="slot" id="c3"></div>
    </div>
    <div class="seat right" id="seat1"><span class="nm2">Pere</span><div class="mini" id="n1"></div></div>
  </div></div>

  <div id="msg"></div>
  <div id="actions"></div>
  <div id="hand"></div>
</div>
<div id="pv"></div>
<div id="ov"><div class="box" id="ovbox"></div></div>

<script>
"use strict";
const SUITS=['oros','copes','espases','bastos'];
const SUITN={oros:'Oros',copes:'Copes',espases:'Espases',bastos:'Bastos'};
const ORDER=[9,1,12,11,10,8,7,6,5,4,3,2];           // de més forta a més feble
const PTS={9:5,1:4,12:3,11:2,10:1};
const RNAME={1:'As',9:'Manilla',10:'Sota',11:'Cavall',12:'Rei'};
const NAMES=['Tu','Pere','Montse','Jordi'];
const COL={oros:'#a67800',copes:'#c42d27',espases:'#2c5fa8',bastos:'#2a7d46'};
const OUT='#2a1a0a';
const st=`stroke="${OUT}" stroke-width="1.1" stroke-linejoin="round"`;
const PIPS={
 oros:(()=>{let rays='';for(let i=0;i<16;i++){const a=i*Math.PI/8,c=Math.cos(a),s=Math.sin(a);rays+=`<path d="M${(12+3.9*c).toFixed(2)} ${(12+3.9*s).toFixed(2)}L${(12+7.5*c).toFixed(2)} ${(12+7.5*s).toFixed(2)}"/>`}
  return `<circle cx="12" cy="12" r="11.3" fill="url(#gCoinRim)" stroke="#3f2800" stroke-width="1.1"/><circle cx="12" cy="12" r="9.9" fill="none" stroke="#6b4600" stroke-width=".55" stroke-dasharray=".7 .9"/><circle cx="12" cy="12" r="8.5" fill="url(#gCoin)" stroke="#6b4600" stroke-width=".7"/><g stroke="#b3770f" stroke-width=".5" stroke-linecap="round">${rays}</g><circle cx="12" cy="12" r="3.9" fill="url(#gCoinRim)" stroke="#6b4600" stroke-width=".6"/><rect x="9.8" y="9.9" width="4.4" height="4.2" rx=".5" fill="#f6c500" stroke="#6b4600" stroke-width=".4"/><g fill="#c8102e"><rect x="10.29" y="9.9" width=".49" height="4.2"/><rect x="11.27" y="9.9" width=".49" height="4.2"/><rect x="12.25" y="9.9" width=".49" height="4.2"/><rect x="13.23" y="9.9" width=".49" height="4.2"/></g><path d="M4.8 7.2A8.3 8.3 0 0 1 11 3.7" stroke="#fffbd8" stroke-width=".9" fill="none" opacity=".85" stroke-linecap="round"/>`})(),
 copes:'<path d="M3.3 2.8h17.4c.3 3.4-.6 6.2-2.8 8.2-1.5 1.4-3.6 2.4-5.9 2.6-2.3-.2-4.4-1.2-5.9-2.6C3.9 9 3 6.2 3.3 2.8z" fill="url(#gCup)" stroke="#4a1608" stroke-width="1"/><rect x="2.8" y="1.6" width="18.4" height="2.8" rx="1.2" fill="url(#gGold)" stroke="#4a1608" stroke-width=".8"/><path d="M7 5.8c3 2.6 7 2.6 10 0" stroke="#f2c230" stroke-width=".9" fill="none"/><circle cx="12" cy="7.6" r="1.25" fill="#2d63b8" stroke="#f2c230" stroke-width=".6"/><path d="M6.6 6.4c.2 2 1.4 3.4 3.2 4.2" stroke="#ffc4a0" stroke-width=".9" fill="none" stroke-linecap="round"/><rect x="10.6" y="13" width="2.8" height="3" fill="url(#gGold)" stroke="#4a1608" stroke-width=".7"/><ellipse cx="12" cy="17.2" rx="3.4" ry="1.6" fill="url(#gGold)" stroke="#4a1608" stroke-width=".8"/><path d="M6.6 22.7c.3-2.6 2.3-3.6 5.4-3.6s5.1 1 5.4 3.6z" fill="url(#gCup)" stroke="#4a1608" stroke-width=".9"/><circle cx="12" cy="21" r=".95" fill="#fff" stroke="#4a1608" stroke-width=".4"/>',
 espases:'<path d="M12 .4l2.8 11.9H9.2z" fill="url(#gSteel)" stroke="#1b4570" stroke-width="1"/><path d="M12 1.8v10.3" stroke="#2a5f90" stroke-width=".8"/><path d="M10.4 11.6L11.7 3" stroke="#fff" stroke-width=".5" opacity=".9"/><path d="M5.2 12.4c2.6 2.3 10.9 2.3 13.6 0" fill="none" stroke="#7e1a14" stroke-width="3" stroke-linecap="round"/><path d="M5.4 12.4c2.6 2.1 10.6 2.1 13.2 0" fill="none" stroke="#e0382c" stroke-width="1.7" stroke-linecap="round"/><circle cx="5" cy="12.3" r="1.3" fill="url(#gGold)" stroke="#5a3d00" stroke-width=".6"/><circle cx="19" cy="12.3" r="1.3" fill="url(#gGold)" stroke="#5a3d00" stroke-width=".6"/><circle cx="12" cy="13" r="1.3" fill="url(#gGold)" stroke="#5a3d00" stroke-width=".6"/><rect x="10.7" y="13.8" width="2.6" height="5.8" rx="1" fill="#c42d27" stroke="#4a0f0a" stroke-width=".7"/><path d="M10.8 15.2l2.4-.8M10.8 16.8l2.4-.8M10.8 18.4l2.4-.8" stroke="#4a0f0a" stroke-width=".5"/><circle cx="12" cy="21.4" r="2" fill="url(#gGold)" stroke="#5a3d00" stroke-width=".8"/><circle cx="12" cy="21.4" r=".8" fill="#2d63b8"/>',
 bastos:'<g transform="rotate(30 12 12)"><path d="M8 20c-2.2-.4-3.2-2-3.4-3.6 1.8.4 3.2 1.4 3.6 3z M16 19.4c2.2-.4 3.2-2 3.4-3.6-1.8.4-3.2 1.4-3.6 3z" fill="#2f8f2c" stroke="#1d5a18" stroke-width=".6"/><path d="M10 1.9c1.2-1.4 3.2-1.4 4.2 0 1.5 1.6 1.4 4.2.9 6.6-.4 2.6-.3 5 .4 7.6.5 1.9.3 4.2-1.1 5.4-1.1 1-2.7 1-3.7.2-1.4-1-1.6-3.2-1.3-5.2.2-2.4.5-4.6-.2-7C8.3 6.9 8.4 3.7 10 1.9z" fill="url(#gClub)" stroke="#2f5a10" stroke-width="1"/><ellipse cx="11" cy="5.4" rx="1.2" ry=".9" fill="#4a7a1a"/><ellipse cx="13.7" cy="9.4" rx="1.3" ry="1" fill="#4a7a1a"/><ellipse cx="10.9" cy="13.2" rx="1.2" ry=".9" fill="#4a7a1a"/><ellipse cx="13.1" cy="17.2" rx="1.1" ry=".9" fill="#4a7a1a"/><path d="M11.4 2.4c-.9 3.2 0 7.2.3 10.4M12.8 14c.2 2 .2 3.6-.2 5" stroke="#d6f598" stroke-width=".8" fill="none" stroke-linecap="round"/><path d="M9.4 6.8l-.8-.3M14.4 12l.8-.3M10 17l-.7.3" stroke="#2f5a10" stroke-width=".5"/></g>'
};
const ICON={};for(const k in PIPS)ICON[k]=`<svg viewBox="0 0 24 24">${PIPS[k]}</svg>`;
const SUITC={oros:'#a67800',copes:'#c42d27',espases:'#2c5fa8',bastos:'#2a7d46'};
const ROBE={oros:['url(#gRed)','url(#gBlue)'],copes:['url(#gBlue)','url(#gRed)'],espases:['url(#gRed)','url(#gGreen)'],bastos:['url(#gGreen)','url(#gRed)']};
const HORSE={oros:'#8a5a36',copes:'#dcd5c4',espases:'#4f3c2e',bastos:'#a8743c'};
const LAY={
 2:[[50,36],[50,104]],
 3:[[50,34],[50,70],[50,106]],
 4:[[35,38],[65,38],[35,102],[65,102]],
 5:[[35,38],[65,38],[50,70],[35,102],[65,102]],
 6:[[35,34],[65,34],[35,70],[65,70],[35,106],[65,106]],
 7:[[35,34],[65,34],[50,52],[35,70],[65,70],[35,106],[65,106]],
 8:[[35,32],[65,32],[35,57],[65,57],[35,83],[65,83],[35,108],[65,108]],
 9:[[35,32],[65,32],[35,57],[65,57],[50,70],[35,83],[65,83],[35,108],[65,108]]
};
function pip(s,x,y,z,rot){return `<g transform="translate(${x} ${y})${rot?' rotate(180)':''} scale(${z/24}) translate(-12 -12)">${PIPS[s]}</g>`}
function barres(x,y,w,h){
  let g=`<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="url(#gGold)" stroke="${OUT}" stroke-width=".8"/>`;
  for(let i=0;i<4;i++)g+=`<rect x="${(x+w*(2*i+1)/9).toFixed(2)}" y="${y}" width="${(w/9).toFixed(2)}" height="${h}" fill="#c8102e"/>`;
  return g;
}
